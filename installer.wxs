<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="铁镌"
    Language="2052"
    Codepage="65001"
    Version="5.1.0"
    Manufacturer="MrKedow"
    UpgradeCode="{B2B0E7A4-6E6F-4E6B-9C3A-7D5F1A2B3C4D}">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的铁镌。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="windows\runner\resources\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Iron Etch" />
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="IronEtchMenuFolder" Name="Iron Etch" />
      </Directory>
    </Directory>

    <DirectoryRef Id="IronEtchMenuFolder">
      <Component Id="ApplicationShortcuts" Guid="{A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D}">
        <Shortcut
          Id="StartMenuShortcut"
          Name="铁镌"
          Description="铁镌 Iron Etch"
          Target="[INSTALLFOLDER]Iron_Etch.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveIronEtchMenuFolder" Directory="IronEtchMenuFolder" On="uninstall" />
        <RegistryValue
          Root="HKLM"
          Key="Software\MrKedow\IronEtch"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="铁镌" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>
  </Product>
</Wix>
